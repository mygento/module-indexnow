{
    "name": "mygento/module-indexnow",
    "description": "Mygento IndexNow package",
    "type": "magento2-module",
    "license": "proprietary",
    "homepage": "https://github.com/mygento/module-indexnow",
    "authors": [
        {
            "name": "Mygento",
            "email": "connect@mygento.net",
            "homepage": "https://www.mygento.com/"
        }
    ],
    "keywords": [
        "magento",
        "indexnow"
    ],
    "require": {
        "php": ">=8.3.0",
        "magento/module-catalog": "104.*"
    },
    "require-dev": {
        "mygento/coding-standard": "~2.14.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Mygento\\IndexNow\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true,
            "magento/composer-dependency-version-audit-plugin": false
        }
    }
}

